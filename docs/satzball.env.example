# Umgebungsvariablen für den Container auf dem VPS.
# Kopieren nach /etc/satzball.env, Werte anpassen, Rechte einschränken: chmod 600 /etc/satzball.env
# Die Datei NICHT ins Git einchecken.

# Domain, unter der nginx die App ausliefert
DJANGO_ALLOWED_HOSTS=volleyball.example.de
DJANGO_CSRF_TRUSTED_ORIGINS=https://volleyball.example.de
DJANGO_HTTPS=1

# AGPL: Link zum Quellcode in der Fußzeile. Wer Satzball verändert betreibt, trägt hier sein eigenes Repo ein.
# SATZBALL_QUELLCODE_URL=https://github.com/Kootaro05/Satzball

# Optional: eigener Secret Key. Ohne Angabe wird einer erzeugt und im Volume gespeichert.
# DJANGO_SECRET_KEY=

# Mailversand für den Bearbeitungslink (Hochschul- oder Orga-Postfach).
# Ohne EMAIL_HOST landen Mails nur im Container-Log (docker logs satzball).
EMAIL_HOST=smtp.example.de
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=volleyball-orga@example.de
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Volleyball-Orga <volleyball-orga@example.de>
